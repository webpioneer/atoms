{
  "name": "Atoms — Habit Tracker",
  "short_name": "Atoms",
  "description": "Track daily habits, goals and progress using the principles of Atomic Habits.",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f4ee",
  "theme_color": "#1f7a6b",
  "icons": [
